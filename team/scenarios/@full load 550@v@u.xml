            historyState="XMIN" includeInReport="false"
            rangeMarkerVisible="true" title="Controller/Thread Count" typeName="CLASSIC">
            <monitor-curve-description color="244,239,0"
                connectionName="NeoLoad" dashed="false"
                monitorName="threadcount" monitoredHostName="NeoLoad"
                scale="0.1" selected="false"/>
            <monitor-curve-description color="20,106,203"
                connectionName="NeoLoad" dashed="false"
                monitorName="zoneuserloadperpopulation~Default zone~DMP-1.5-Dryrun~DMP 1.5 Supplier Registration - Working on AWS NFT"
                monitoredHostName="NeoLoad" scale="0.1" selected="true"/>
        </chart-description>
        <chart-description autoRange="true"
            chart-description-type="chart-description-type"
            domainMarkerVisible="true" granularityLevel="0"
            historyState="XMIN" includeInReport="false"
            rangeMarkerVisible="true"
            title="Last step completed  Logout - Average duration" typeName="CLASSIC">
